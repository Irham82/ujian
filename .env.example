# ============================================================================
# CBT PRO — ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Jangan menyimpan secret produksi di dalam repository. Salin ke .env
# ============================================================================

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
SCHOOL_TIMEZONE=Asia/Makassar

# Database PostgreSQL
# Untuk produksi / Docker: postgresql://cbt_user:CHANGE_ME@localhost:5432/cbt_pro
# Untuk mode embedded PostgreSQL 16 lokal (PGlite): pglite://./.pglite-data
DATABASE_URL=pglite://./.pglite-data
DB_POOL_MAX=50

# Redis (Cache, Rate Limiting, Session Coordination)
# Kosongkan atau gunakan memory:// untuk fallback in-memory pada pengujian lokal tanpa daemon Redis
REDIS_URL=memory://localhost:6379

# Security & Session Secrets (WAJIB diganti dengan nilai acak minimal 32 byte di produksi)
JWT_ACCESS_SECRET=CHANGE_ME_WITH_AT_LEAST_32_BYTES_RANDOM_HEX_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_WITH_DIFFERENT_32_BYTES_RANDOM_HEX_SECRET
CSRF_SECRET=CHANGE_ME_WITH_CSRF_HMAC_SECRET_KEY_32_BYTES
BACKUP_ENCRYPTION_KEY=CHANGE_ME_WITH_32_BYTE_HEX_KEY_FOR_AES_256_GCM

# Kebijakan Default Ujian & Offline
DEFAULT_OFFLINE_GRACE_PERIOD_SECONDS=120
DEFAULT_MAX_OFFLINE_UNSYNCED_ANSWERS=100
DEFAULT_CAMERA_ENABLED=false
DEFAULT_CAMERA_RETENTION_DAYS=14

# Object Storage (S3 / MinIO Compatible untuk Aset Soal & Media)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-assets
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=cbt-pro-assets
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
